# NextAuth.js (next-auth v5) の設定

# Google OAuth認証情報
# Google Cloud Console (https://console.cloud.google.com) で取得してください
AUTH_GOOGLE_ID=your-google-client-id-here
AUTH_GOOGLE_SECRET=your-google-client-secret-here

# NextAuthのシークレットキー（ランダム文字列）
# 生成方法: openssl rand -base64 32
AUTH_SECRET=your-random-secret-key-here

# ログイン許可するメールドメイン（任意）
# 例: datalogic.co.jp ← このドメインのGoogleアカウントのみ許可
# 空白にすると全てのGoogleアカウントでログイン可能
ALLOWED_EMAIL_DOMAIN=

# ログイン許可する個別のGoogleアカウント（カンマ区切り、任意）
# 例: user1@gmail.com,user2@gmail.com
# ALLOWED_EMAIL_DOMAIN と併用可能（どちらかに合致すればログイン可能）
ALLOWED_EMAILS=

# Vercelへのデプロイ時はこちらのURLも設定する
# NEXTAUTH_URL=https://your-vercel-app.vercel.app
